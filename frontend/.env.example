# URL base da API.
#
# Desenvolvimento local (vite dev, porta 5173/5174): aponte para o backend
# Spring Boot rodando local, ex.: http://localhost:8080
#
# Producao: deixe VAZIO (ou remova esta variavel). O Spring Boot serve o
# frontend buildado e a API na MESMA ORIGEM (ver vite.config.ts: o build
# cai dentro de src/main/resources/static do proprio backend) — nao ha
# outra URL para apontar, e definir uma aqui quebraria o app publicado
# (ver Sprint 16.2, achado: build antigo com localhost:8080 embutido).
VITE_API_BASE_URL=http://localhost:8080

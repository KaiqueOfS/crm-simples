# Copie este arquivo para ".env" e preencha os valores reais.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# --- Banco de dados -------------------------------------------------------
# Usado tanto para rodar localmente (./mvnw spring-boot:run) quanto pelo
# docker-compose (que sobrescreve DB_HOST para "mysql" automaticamente).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crm_simples
DB_USER=root
DB_PASSWORD=

# --- Autenticação -----------------------------------------------------
# Segredo usado para assinar os tokens JWT. Gere uma string aleatória com
# pelo menos 32 caracteres — nunca reaproveite a mesma chave entre ambientes.
JWT_SECRET=

# --- CORS -------------------------------------------------------------
# Origens permitidas para chamadas à API, separadas por vírgula. Em
# produção, use o domínio real do frontend (ex.: https://meucrm.com.br).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Perfil da aplicação ------------------------------------------------
# "dev" (padrão local, logs verbosos) ou "prod" (logs reduzidos, ver
# application-dev.properties / application-prod.properties).
SPRING_PROFILES_ACTIVE=dev

# --- Conta demo ---------------------------------------------------------
# Liga a conta demo (demo@orbiscrm.com) na inicialização — ver DemoSeeder.
# Deixe "false" fora de ambiente de apresentação/demo.
DEMO_SEED_ENABLED=false
